# Postgres database connection string
DATABASE_URI=postgresql://metron:metron_dev_pass@localhost:5432/metron_db

# Admin password used once by `npm run seed` to create the initial CMS user
# Change immediately after first login in production
SEED_ADMIN_PASSWORD=

# Payload CMS secret — generate a random string (32+ chars) for production
PAYLOAD_SECRET=your-super-secret-payload-secret-change-in-production

# Application URL (used by Payload for redirects and asset URLs)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# SMTP configuration (fill in when ready to send emails — not required for local dev)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@metronengineering.com.au
SMTP_NOTIFY_TO=sam@metronengineering.com.au
